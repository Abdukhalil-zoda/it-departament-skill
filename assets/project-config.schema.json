{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antigravity.internal/schemas/it-department-config.schema.json",
  "title": "ITDepartmentProjectConfig",
  "description": "Configuration schema for target projects governed by the IT Department skill.",
  "type": "object",
  "required": [
    "project_name",
    "schema_version",
    "cto_mode",
    "delegated_authorities",
    "git_policy",
    "quality_gates",
    "paths",
    "security"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional URI or relative path to this schema definition."
    },
    "project_name": {
      "type": "string",
      "minLength": 1,
      "description": "Name of the target project."
    },
    "schema_version": {
      "type": "string",
      "enum": ["2.0.0"],
      "description": "Version of the configuration contract."
    },
    "cto_mode": {
      "type": "string",
      "enum": ["VIRTUAL", "USER"],
      "description": "Decision and communication mode for the CTO persona."
    },
    "cto_mode_options": {
      "type": "object",
      "description": "Descriptions of CTO operational modes.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "operating_profile": {
      "type": "string",
      "enum": ["prototype", "pilot", "production"],
      "description": "Operating profile that sets the depth of every gate (workflows/operating-profiles.md). Owned by the CTO. Optional; absent = production."
    },
    "profile_review": {
      "type": "object",
      "description": "Facts behind the operating profile, re-checked by the coordinator at project init, when they change and at every release gate (workflows/operating-profiles.md). All fields optional.",
      "additionalProperties": false,
      "properties": {
        "active_users": { "type": "integer", "minimum": 0, "description": "Real active users today; above the CTO's pilot threshold (default 50) the project is production." },
        "payments_live": { "type": "boolean", "description": "Live payments are processed; true means production." },
        "sla_promised": { "type": "boolean", "description": "An SLA or uptime commitment was given to users or customers; true means production." },
        "regulated_data": { "type": "boolean", "description": "Data under specific regulation is processed (e.g. health records, card data); true means production." },
        "reviewed_at": { "type": "string", "description": "Date of the last review of these facts (YYYY-MM-DD)." },
        "note": { "type": "string", "description": "Why this profile; what would trigger the next one." }
      }
    },
    "delegated_authorities": {
      "type": "object",
      "required": [
        "allow_merge_integration",
        "allow_merge_production",
        "allow_deploy_production",
        "allow_infra_provisioning",
        "allow_destructive_operations",
        "allow_schema_migrations",
        "allow_dependency_updates"
      ],
      "additionalProperties": false,
      "properties": {
        "allow_merge_integration": { "type": "boolean" },
        "allow_merge_production": { "type": "boolean" },
        "allow_deploy_production": { "type": "boolean" },
        "allow_infra_provisioning": { "type": "boolean" },
        "allow_destructive_operations": { "type": "boolean" },
        "allow_schema_migrations": { "type": "boolean" },
        "allow_dependency_updates": { "type": "boolean" }
      }
    },
    "git_policy": {
      "type": "object",
      "required": [
        "production_branch",
        "integration_branch",
        "branch_naming_patterns",
        "worktrees_enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "production_branch": {
          "type": "string",
          "minLength": 1
        },
        "integration_branch": {
          "type": "string",
          "minLength": 1
        },
        "branch_naming_patterns": {
          "type": "object",
          "required": ["feature", "bug", "hotfix"],
          "additionalProperties": false,
          "properties": {
            "feature": { "type": "string", "minLength": 1 },
            "bug": { "type": "string", "minLength": 1 },
            "hotfix": { "type": "string", "minLength": 1 }
          }
        },
        "worktrees_enabled": { "type": "boolean" }
      }
    },
    "quality_gates": {
      "type": "object",
      "required": [
        "test_coverage_threshold_percent",
        "require_peer_code_review",
        "require_qa_signoff",
        "blocking_defect_severities"
      ],
      "additionalProperties": false,
      "properties": {
        "test_coverage_threshold_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "require_peer_code_review": { "type": "boolean" },
        "require_qa_signoff": { "type": "boolean" },
        "blocking_defect_severities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["Critical", "Major", "Minor", "Trivial"]
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "required": [
        "vault_relative_path",
        "sessions_relative_path",
        "worktrees_relative_path"
      ],
      "additionalProperties": false,
      "properties": {
        "vault_relative_path": {
          "type": "string",
          "minLength": 1
        },
        "sessions_relative_path": {
          "type": "string",
          "minLength": 1
        },
        "worktrees_relative_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "security": {
      "type": "object",
      "required": [
        "production_secrets_agent_access",
        "test_secrets_agent_managed",
        "commit_real_credentials"
      ],
      "additionalProperties": false,
      "properties": {
        "production_secrets_agent_access": { "type": "boolean" },
        "test_secrets_agent_managed": { "type": "boolean" },
        "commit_real_credentials": { "type": "boolean" }
      }
    },
    "documents": {
      "type": "array",
      "description": "Project documents listed in the dashboard's Documents block (scripts/dashboard_sync.py); paths are relative to the project root, inside or outside the vault.",
      "items": {
        "type": "object",
        "required": ["title", "path"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "efficiency": {
      "type": "object",
      "description": "Token optimizer: efficiency rules R1-R5, usage ledger and the scheduled usage audit (workflows/efficiency-and-usage-audit.md). Optional for projects created before schema 2.0.0 gained it.",
      "additionalProperties": false,
      "properties": {
        "audit_interval_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "description": "How often the usage audit runs; keep the scheduled task in sync."
        },
        "audit_model": {
          "type": "string",
          "minLength": 1,
          "description": "Model id or alias of the strongest available model that runs the audit."
        },
        "report_language": {
          "type": "string",
          "minLength": 2,
          "description": "Language of the audit report and the CTO message, as a language name the auditing model understands (e.g. \"English\", \"Russian\")."
        },
        "rules": {
          "type": "object",
          "description": "Numeric limits enforced in task briefs and measured by the audit. Keys are prefixed with the rule id (R1-R5).",
          "additionalProperties": { "type": "number" },
          "properties": {
            "R1_builds_per_fix_round_max": { "type": "number", "minimum": 1 },
            "R2_screenshots_per_scenario_max": { "type": "number", "minimum": 1 },
            "R2_screenshot_scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "R3_full_suite_runs_per_candidate_max": { "type": "number", "minimum": 1 },
            "R4_summary_lines_max": { "type": "number", "minimum": 1 },
            "R4_log_tail_lines": { "type": "number", "minimum": 1 },
            "R4_tool_result_tokens_max": { "type": "number", "minimum": 100 },
            "R5_queue_wait_minutes_max": { "type": "number", "minimum": 0 },
            "R5_split_jobs_longer_than_minutes": { "type": "number", "minimum": 1 }
          }
        },
        "token_weights": {
          "type": "object",
          "description": "Effective cost weights used by usage_ledger.py (input=1 by convention).",
          "additionalProperties": false,
          "properties": {
            "input": { "type": "number", "minimum": 0 },
            "cache_write": { "type": "number", "minimum": 0 },
            "cache_read": { "type": "number", "minimum": 0 },
            "output": { "type": "number", "minimum": 0 }
          }
        },
        "ledger_path": {
          "type": "string",
          "minLength": 1,
          "description": "Project-relative directory of the usage ledger JSON files (aggregates only, versioned)."
        },
        "jobs_log_path": {
          "type": "string",
          "minLength": 1,
          "description": "Project-relative directory of build/test/device job logs or jobs.jsonl (machine-time feed, optional)."
        },
        "reports_path": {
          "type": "string",
          "minLength": 1,
          "description": "Project-relative directory of the usage audit reports (inside the vault by default)."
        }
      }
    },
    "content_review": {
      "type": "object",
      "description": "Content & Localization Reviewer: locales, resource locations and the two review checkpoints (workflows/content-review.md). Optional; defaults apply when absent.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "source_locale": { "type": "string", "minLength": 2, "description": "Locale authors write first (e.g. en, ru)." },
        "locales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 },
          "description": "Every locale the product ships, including the source locale."
        },
        "locale_scripts": {
          "type": "object",
          "additionalProperties": { "type": "string", "enum": ["Latin", "Cyrillic", "Arabic", "Greek", "Hebrew", "CJK"] },
          "description": "Expected writing system per locale when the default inference is wrong (e.g. {\"uz\": \"Latin\"})."
        },
        "checkpoints": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["task-creation", "pre-release"] }
        },
        "block_release_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["Critical", "Major", "Minor", "Trivial"] },
          "description": "Content defect severities that block a release (default Critical, Major)."
        },
        "glossary_path": { "type": "string", "minLength": 1 },
        "style_guide_path": { "type": "string", "minLength": 1 },
        "reports_path": { "type": "string", "minLength": 1, "description": "Where content inventories and reviews are written (default: efficiency.reports_path or vault/05-Reports)." },
        "text_sources": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Globs of localized resource files (.resx, i18n JSON, Android strings.xml, iOS .strings)." },
        "inline_tables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "locales"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "locales": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } }
            }
          },
          "description": "Code files that define strings as [\"Key\"] = (\"text locale 1\", \"text locale 2\")."
        },
        "markup_sources": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Globs of markup files scanned for hardcoded user-facing text." },
        "content_data_sources": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Globs of JSON data files with per-locale subtrees that ship to users." },
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
